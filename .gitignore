# OSDev_Learning_Hub .gitignore
# -> Build artifacts are never committed.

# Node
node_modules/

# Compiled objects & binaries
*.o
*.obj
*.a
*.lib
*.elf
*.bin
kernel.bin
*.exe

# Disk / ISO images
*.iso
*.img
*.qcow2
*.vdi
*.vmdk

# Build / dist output
build/
dist/
target/
out/

# Logs
*.log

# Toolchain local caches
.cache/
*.tmp

# Editor
.phoenix/
.brackets.json.local
Thumbs.db

# Rust (Example_OS_Project/rust)
Cargo.lock

# Session context pack (regenerable) & local notes
repomix-*.md
repomix.config.json
SESSION_HANDOFF.md

# ===== PRIVATE / SECRETS - NEVER COMMIT OR PUSH =====
# Full credential map (logins, DB passwords, SSH access) + guest-access guide.
# Local copy only; kept out of git so it never reaches GitHub/Gitea.
# Back it up manually (e.g. into a password manager) - do NOT push this repo.
sektor9-credentials.md
sektor9-private/
sektor9-private/*

# Book-library config that embeds the live auth hash — never commit.
resources/Caddyfile.new
